# Internal working notes (not part of the public repo)
CLAUDE.md
DECISIONS.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Env / secrets — .env.* covers .env.local/.env.prod-style variants forks tend to create;
# the committed template is explicitly re-allowed. Git history is forever.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Ingestion cache
data/raw/*.vtt

# Dataset bundles — local artifacts only, transcript content is never committed. The directory
# itself is tracked (.gitkeep) so a fresh clone has it host-owned before docker compose
# bind-mounts it into the non-root container; everything inside it is ignored.
datasets/*
!datasets/.gitkeep

# OS
.DS_Store

# Build artifacts
dist/
build/
