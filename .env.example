# Comments are on their own lines on purpose: python-dotenv and docker compose accept inline
# `KEY=value  # note` comments, but `docker run --env-file` and some shells do not.

# ── Instance ─────────────────────────────────────────────────────────────
# selfhost (default: no auth, no quotas, your own keys) or cloud (future, not built).
INSTANCE_MODE=selfhost

# ── Database ─────────────────────────────────────────────────────────────
# docker-compose reads POSTGRES_PASSWORD; keep DATABASE_URL in sync if you change it.
# Use 127.0.0.1 rather than localhost: compose publishes the port on IPv4 loopback only, and
# `localhost` may resolve to ::1 first, costing a failed connection attempt on every command.
POSTGRES_PASSWORD=aac
DATABASE_URL=postgresql://aac:aac@127.0.0.1:5432/askanychannel

# ── Embedding key (always required) ─────────────────────────────────────
# Required for `aac dataset build` / `aac ingest` / `aac search` / every chat turn — the
# question is always embedded via OpenAI regardless of CHAT_PROVIDER below. Not needed for
# `aac dataset load` when the bundle's embeddings already match your configured model.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint. Leave blank for api.openai.com. Note that the
# endpoint must serve the embedding model in core/constants.py (text-embedding-3-small,
# 1536 dims) for ingest/search — chat can point anywhere.
OPENAI_BASE_URL=

# ── Chat key (only required if CHAT_PROVIDER=anthropic below) ──────────
ANTHROPIC_API_KEY=
# Optional: any Anthropic-compatible endpoint. Leave blank for api.anthropic.com.
ANTHROPIC_BASE_URL=

# ── Chat behavior ────────────────────────────────────────────────────────
# Which vendor answers chat turns: "openai" or "anthropic". Embedding always uses OpenAI
# regardless of this setting. Leave CHAT_MODEL blank to use each provider's default model.
CHAT_PROVIDER=openai
CHAT_MODEL=

# ── Retrieval ────────────────────────────────────────────────────────────
# "hybrid" (default) fuses vector search with full-text search (RRF) — best for exact names,
# numbers, and framework titles a channel uses verbatim. "dense" is pure vector search only.
RETRIEVAL_MODE=hybrid

# ── Storage ──────────────────────────────────────────────────────────────
# Where cached .vtt caption files are written (gitignored, safe to delete). Leave blank to
# use the built-in default (data/raw).
RAW_CAPTIONS_DIR=data/raw
